DATABASE_URL=postgres://user:pass@localhost/dev_database_name
PORT=3000
CONTENT_BASE_URL=https://cntnt.xplaya.com
SITE_URL=https://xplaya.com
# App de clientes (PWA del monedero). En desarrollo, *.localhost apunta a tu máquina:
# APP_URL=http://app.localhost:3000
# Dominio de las passkeys; en desarrollo, el mismo host de APP_URL (Chrome no acepta
# "localhost" para una página en app.localhost).
# PASSKEY_RP_ID=app.localhost
# GOTENBERG_URL=http://gotenberg-service.gotenberg.svc.cluster.local:3000
# Código de tienda del Perfil de Negocio de Google ("Papelería y Mercería El Gordo").
# Se ve en Merchant Center → inventario local, o en el Perfil de Negocio como "código de tienda".
# Sin esta variable, /feeds/google-local.xml responde 404 (el feed de productos sigue funcionando).
# GOOGLE_STORE_CODE=

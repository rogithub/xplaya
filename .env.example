DATABASE_URL=postgres://user:pass@localhost/dev_database_name
PORT=3000
CONTENT_BASE_URL=https://cntnt.xplaya.com
SITE_URL=https://xplaya.com
# App de clientes (PWA del monedero). En desarrollo, *.localhost apunta a tu máquina:
# APP_URL=http://app.localhost:3000
# Dominio de las passkeys; en desarrollo, el mismo host de APP_URL (Chrome no acepta
# "localhost" para una página en app.localhost).
# PASSKEY_RP_ID=app.localhost
# GOTENBERG_URL=http://gotenberg-service.gotenberg.svc.cluster.local:3000
# Código de tienda del Perfil de Negocio de Google ("Papelería y Mercería El Gordo").
# Se ve en Merchant Center → inventario local, o en el Perfil de Negocio como "código de tienda".
# Sin esta variable, /feeds/google-local.xml responde 404 (el feed de productos sigue funcionando).
# GOOGLE_STORE_CODE=

# Kiosko de la tienda (app.xplaya.com/kiosko). Vacío = apagado.
# KIOSKO_TOKEN=lo-que-sea
# Notificaciones Web Push de la app. Llave privada VAPID (base64url, 32 bytes). Vacía = apagadas.
# Generarla (una por ambiente; nunca la de producción en desarrollo):
#   openssl ecparam -genkey -name prime256v1 -noout -outform DER | tail -c +8 | head -c 32 \
#     | base64 | tr '+/' '-_' | tr -d '=\n'
# VAPID_PRIVATE_KEY=

# Fotos en la app (src/fotos.rs): llave Ed25519 (base64url, 32 bytes) que firma el permiso con el
# que el celular manda sus fotos a imagina. Vacía: la app no ofrece Fotos. Generarla:
#   openssl genpkey -algorithm ed25519 -outform DER | tail -c 32 | base64 | tr '+/' '-_' | tr -d '=\n'
# Al arrancar, xplaya escribe en el log la pública que va en XPLAYA_LLAVE_PUBLICA de imagina.
# FOTOS_LLAVE_PRIVADA=
# NATS: aviso al instante de notificaciones nuevas (usuario `xplaya`, solo lee su consumer del
# stream NOTIFICACIONES). Sin usuario: solo la revisión de la tabla cada 2 minutos.
# Desde la LAN: nats://192.168.0.10:30526
# NATS_URL=nats://nats.nats.svc.cluster.local:4222
# NATS_USUARIO=
# NATS_PASSWORD=

# MinIO del autoservicio de impresión ("Imprime tú solito"): usuario `xplaya-impresiones`, solo el
# bucket `papeleria-impresiones`. Sin usuario, la pestaña Imprimir no aparece. En desarrollo, el
# MinIO local (contenedor imagina-minio) con el mismo bucket, usuario y política.
# MINIO_ENDPOINT=http://minio.minio-system.svc.cluster.local:9000
# MINIO_USUARIO=
# MINIO_PASSWORD=

# Entrar con Google (src/google.rs) por el Keycloak del cluster, para celulares que no pueden crear
# passkey. Sin los dos, el botón no aparece. En desarrollo, el realm xplaya-dev; el
# secreto está en Keycloak → Clients → xplaya → Credentials.
KEYCLOAK_ISSUER=https://auth.xplaya.com/realms/xplaya-dev
KEYCLOAK_CLIENT_SECRET=

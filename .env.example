DATABASE_URL=postgres://user:pass@localhost/dev_database_name
PORT=3000
CONTENT_BASE_URL=https://cntnt.xplaya.com
SITE_URL=https://xplaya.com
# GOTENBERG_URL=http://gotenberg-service.gotenberg.svc.cluster.local:3000
# Token del kiosko físico. La Raspberry arranca Chromium en /kiosko/activar?t=<token>,
# que siembra una cookie HttpOnly; POST /kiosko/pedidos valida esa cookie.
# El token nunca aparece en el HTML — las páginas /kiosko son públicas.
KIOSKO_TOKEN=
# Servicio bge-m3 para el fallback de búsqueda semántica (Embeddings Fase 4).
# Sin definir → el fallback queda apagado, la búsqueda funciona solo con la vía normal.
# BGE_EMBEDDINGS_URL=http://bge-embeddings.ai.svc.cluster.local:8000
